{
  "name": "camila",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "scripts": {
    "verify:local": "node scripts/verify-local.mjs",
    "dev": "pnpm --filter @camila/contracts build && node scripts/dev.mjs",
    "build": "pnpm --filter @camila/contracts --filter @camila/api --filter @camila/admin build",
    "test": "pnpm test:unit",
    "test:unit": "pnpm --filter @camila/contracts test:unit && pnpm --filter @camila/api test:unit && pnpm --filter @camila/admin test:unit",
    "test:integration": "pnpm --filter @camila/api test:integration",
    "test:e2e": "pnpm --filter @camila/admin test:e2e",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @camila/contracts build && pnpm --filter @camila/contracts --filter @camila/api --filter @camila/admin typecheck",
    "admin:create": "pnpm --filter @camila/api admin:create",
    "admin:reset-password": "pnpm --filter @camila/api admin:reset-password",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:strict": "eslint . --max-warnings=0",
    "security:secrets": "node scripts/security-scan.mjs secrets",
    "security:filesystem": "node scripts/security-scan.mjs filesystem",
    "security:images": "node scripts/security-scan.mjs images",
    "security:all": "node scripts/security-scan.mjs all",
    "test:coverage": "node scripts/test-coverage.mjs",
    "check:bundle-budget": "node scripts/check-bundle-budget.mjs",
    "check:production-config": "node scripts/check-production-config.mjs",
    "load:webhook": "node --env-file-if-exists=.env tests/load/webhook-load.mjs",
    "load:admin-read": "node --env-file-if-exists=.env tests/load/admin-read-load.mjs",
    "check:load-baselines": "node --env-file-if-exists=.env scripts/check-load-baselines.mjs",
    "test:concurrency": "pnpm --filter @camila/api exec node --env-file-if-exists=../../.env ./node_modules/vitest/vitest.mjs run --project integration test/critical-idempotency.integration.test.ts test/critical-concurrency.integration.test.ts",
    "verify": "pnpm format:check && pnpm lint:strict && pnpm typecheck && pnpm test:unit && pnpm test:integration && pnpm test:e2e && pnpm build && pnpm check:bundle-budget",
    "db:generate": "pnpm --filter @camila/api db:generate",
    "db:migrate": "pnpm --filter @camila/api db:migrate",
    "production:smoke": "node scripts/production-smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0"
  }
}
