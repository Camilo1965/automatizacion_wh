# Caddy reverse proxy for KAIRO.
#
# Production: set CAMILA_DOMAIN to the public hostname. ACME email is [HUMANO].
# Staging/loopback: compose.staging.yaml sets CAMILA_DOMAIN=localhost and
# TLS_INTERNAL=1 so Caddy uses an internal CA (no public DNS required).

{
  {$CADDY_GLOBAL_OPTIONS}
  # [HUMANO] Production ACME contact, e.g.:
  # email ops@example.com
}

{$CAMILA_DOMAIN:localhost} {
  {$CADDY_SITE_OPTIONS}

  encode gzip

  handle /health/* {
    reverse_proxy api:3000 {
      health_uri /health/ready
      health_interval 10s
      health_timeout 5s
    }
  }

  handle /api/* {
    reverse_proxy api:3000 {
      health_uri /health/ready
      health_interval 10s
      health_timeout 5s
    }
  }

  handle {
    reverse_proxy admin:8080 {
      health_uri /
      health_interval 10s
      health_timeout 5s
    }
  }
}
