# syntax=docker/dockerfile:1

FROM node:24-bookworm@sha256:64af3819f9275802414d7cdc38c27e9d82bd564dec4d4da87d008255d36c63b4 AS build
ENV PNPM_HOME="/pnpm"
ENV PATH="${PNPM_HOME}:${PATH}"
RUN corepack enable && corepack prepare pnpm@11.19.0 --activate

WORKDIR /app

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc tsconfig.base.json ./
COPY packages/contracts/package.json packages/contracts/
COPY apps/api/package.json apps/api/
COPY apps/admin/package.json apps/admin/

COPY packages/contracts packages/contracts
COPY apps/admin apps/admin

RUN pnpm install --frozen-lockfile \
  && pnpm --filter @camila/contracts build \
  && pnpm --filter @camila/admin build

# Non-root nginx; listen 8080. Stable digest is locally vulnerability-scanned.
FROM nginxinc/nginx-unprivileged:stable-alpine@sha256:04a3275f25d766cff8926d2e57b2ff34a783d6b12a702dc98bb82226d2d9a508 AS runtime

USER 101
COPY --chown=101:101 docker/nginx-admin.conf /etc/nginx/conf.d/default.conf
COPY --from=build --chown=101:101 /app/apps/admin/dist /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/ >/dev/null 2>&1 || exit 1

CMD ["nginx", "-g", "daemon off;"]
