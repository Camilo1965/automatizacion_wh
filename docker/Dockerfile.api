# syntax=docker/dockerfile:1

FROM node:24-bookworm@sha256:14078204b6bb268c107ceff6d3c43f45a888105e5c2b18b14c32b3409d93a1b0 AS build
ENV PNPM_HOME="/pnpm"
ENV PATH="${PNPM_HOME}:${PATH}"
RUN corepack enable && corepack prepare pnpm@11.19.0 --activate

WORKDIR /app

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc tsconfig.base.json ./
COPY packages/contracts/package.json packages/contracts/
COPY apps/api/package.json apps/api/
COPY apps/admin/package.json apps/admin/

COPY packages/contracts packages/contracts
COPY apps/api apps/api

RUN pnpm install --frozen-lockfile \
  && pnpm --filter @camila/contracts build \
  && pnpm --filter @camila/api build

RUN pnpm deploy --filter @camila/api --prod --legacy /out/api \
  && mkdir -p /out/api/drizzle \
  && cp -a /app/apps/api/drizzle/. /out/api/drizzle/ \
  && rm -rf /out/api/node_modules/@camila/contracts \
  && mkdir -p /out/api/node_modules/@camila \
  && cp -a /app/packages/contracts /out/api/node_modules/@camila/contracts

FROM node:24-bookworm-slim@sha256:a5f4366e834695d5f363b920c104953a535d3a9864d1bdf74566a0ebe01daee5 AS runtime
WORKDIR /app

RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
      /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
      /usr/local/bin/yarn /usr/local/bin/yarnpkg /opt/yarn* /root/.cache \
  && apt-get update \
  && apt-get upgrade -y \
  && rm -rf /var/lib/apt/lists/* \
  && groupadd --system --gid 1001 camila \
  && useradd --system --uid 1001 --gid camila --home-dir /app camila

COPY --from=build --chown=camila:camila /out/api /app

USER camila
ENV NODE_ENV=production
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/health/live').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "dist/server.js"]
