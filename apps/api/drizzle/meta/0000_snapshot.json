          "value": "\"catalog_references\".\"photo_byte_size\" IS NULL OR \"catalog_references\".\"photo_byte_size\" > 0"
        },
        "catalog_references_photo_mime_type": {
          "name": "catalog_references_photo_mime_type",
          "value": "\"catalog_references\".\"photo_mime_type\" IS NULL OR \"catalog_references\".\"photo_mime_type\" IN ('image/jpeg', 'image/png')"
        },
