{
  "name": "@camila/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run --project unit",
    "test:integration": "node --env-file=../../.env ./node_modules/vitest/vitest.mjs run --project integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=../../.env src/database/migrate.ts",
    "admin:create": "tsx --env-file=../../.env src/cli/admin-create.ts",
    "admin:reset-password": "tsx --env-file=../../.env src/cli/admin-reset-password.ts",
    "localities:import": "tsx --env-file=../../.env src/cli/localities-import.ts"
  },
  "dependencies": {
    "@camila/contracts": "workspace:*",
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/multipart": "9.3.0",
    "@fastify/rate-limit": "10.3.0",
    "@inquirer/password": "4.0.23",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.3",
    "fastify-raw-body": "6.0.1",
    "file-type": "22.0.2",
    "postgres": "3.4.9",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "5.0.0",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
