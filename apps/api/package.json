{
  "name": "@camila/api",
  "private": true,
  "type": "module",
  "scripts": {
    "config:import-legacy": "tsx --env-file=../../.env src/cli/run-import-legacy-config.ts",
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "dev:worker": "tsx watch --env-file=../../.env src/worker.ts",
    "start": "node --env-file=../../.env dist/server.js",
    "start:worker": "node --env-file=../../.env dist/worker.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "node --env-file-if-exists=../../.env ./node_modules/vitest/vitest.mjs run --project integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=../../.env src/database/migrate.ts",
    "admin:create": "tsx --env-file=../../.env src/cli/admin-create.ts",
    "admin:reset-password": "tsx --env-file=../../.env src/cli/admin-reset-password.ts",
    "localities:import": "tsx --env-file=../../.env src/cli/localities-import.ts",
    "shipping:acceptance": "tsx --env-file=../../.env src/cli/controlled-shipping-acceptance.ts",
    "retention:simulate": "tsx --env-file=../../.env src/cli/retention-simulate.ts",
    "retention:execute": "tsx --env-file=../../.env src/cli/retention-execute.ts",
    "storage:migrate-media": "tsx --env-file=../../.env src/cli/migrate-media-to-object-storage.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1137.0",
    "@camila/contracts": "workspace:*",
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/multipart": "9.3.0",
    "@fastify/rate-limit": "10.3.0",
    "@inquirer/password": "4.0.23",
    "@smithy/node-http-handler": "4.12.1",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.3",
    "fastify-raw-body": "6.0.1",
    "file-type": "22.0.2",
    "postgres": "3.4.9",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "5.0.0",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
