# Production environment — copy to .env.prod on the server only.
# Never commit .env.prod or real credentials.

NODE_ENV=production
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Public URL of the admin UI (scheme + host + port if non-default).
# Must match what browsers use after the reverse proxy.
ADMIN_ORIGIN=https://admin.example.com

# Shared media directory (bind-mounted volume; used for local driver and migration source).
MEDIA_ROOT=/data/media

# Production MUST use S3-compatible object storage (not MinIO-in-compose).
STORAGE_DRIVER=s3
S3_ENDPOINT=https://s3.example.com
S3_BUCKET=kairo-media
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=change_me
S3_SECRET_ACCESS_KEY=change_me
S3_FORCE_PATH_STYLE=true
S3_TLS_REJECT_UNAUTHORIZED=true

# Postgres (compose service `postgres`; not exposed on the public internet).
POSTGRES_DB=camila
POSTGRES_USER=camila
POSTGRES_PASSWORD=change_me_use_long_random_secret

# DATABASE_URL is composed in compose.prod.yaml for api/worker; set only for one-off migrate jobs:
# DATABASE_URL=postgresql://camila:change_me_use_long_random_secret@postgres:5432/camila

# Required in production (32-byte key, base64). Generate:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KAIRO_CONFIG_ENCRYPTION_KEY=

# Admin session security (non-secret). Absolute lifetime and idle timeout.
# Defaults: 12h absolute; 60 min idle in production.
SESSION_ABSOLUTE_TTL_HOURS=12
SESSION_IDLE_TTL_MINUTES=60
# Throttle DB writes for last-seen (seconds). Default 300.
SESSION_LAST_SEEN_THROTTLE_SECONDS=300

# Retention execution (default OFF). Dry-run is always available to owners.
# Requires an approved active policy AND this flag before anonymize/delete runs.
RETENTION_EXECUTION_ENABLED=false

# WhatsApp Cloud API — set when webhooks and outbound messaging are live.
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v26.0

# 99envíos — set both email and password together when creating real shipping labels.
# NINETYNINE_ENVIOS_EMAIL=
# NINETYNINE_ENVIOS_PASSWORD=
# NINETYNINE_ENVIOS_INTEGRATION_TOKEN=
# NINETYNINE_ENVIOS_INTEGRATION_ID=

# Optional: reverse proxy / ops
# CAMILA_DOMAIN=admin.example.com
