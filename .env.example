# Local development environment for Camila.
# Copy this file to .env before starting services.
# Never commit .env or real credentials.

# Application
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
ADMIN_ORIGIN=http://127.0.0.1:5173
LOG_LEVEL=info
MEDIA_ROOT=./var/media

# WhatsApp Cloud API webhook. Set a long random value only in .env; never commit it.
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v26.0

# 99envíos. Configure ambas credenciales solo cuando vaya a crear guías reales.
# NINETYNINE_ENVIOS_EMAIL=
# NINETYNINE_ENVIOS_PASSWORD=
# NINETYNINE_ENVIOS_INTEGRATION_TOKEN=
# NINETYNINE_ENVIOS_INTEGRATION_ID=

# Required in production; enables encrypted credentials in the KAIRO panel.
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this value outside the database and never rotate it without a credential re-encryption procedure.
# KAIRO_CONFIG_ENCRYPTION_KEY=
# INTEGRATION_ENCRYPTION_KEY= # legacy alias; prefer KAIRO_CONFIG_ENCRYPTION_KEY

# Development PostgreSQL (compose service: postgres)
POSTGRES_DB=camila
POSTGRES_USER=camila
POSTGRES_PASSWORD=camila_dev_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://camila:camila_dev_only@127.0.0.1:5432/camila

# Integration tests (compose profile: test, service: postgres-test)
# Credentials below are local fixtures only; they are not production secrets.
TEST_DATABASE_URL=postgresql://camila_test:camila_test@127.0.0.1:5433/camila_test
